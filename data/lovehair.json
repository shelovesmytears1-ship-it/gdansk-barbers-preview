  "faq": [
    {
      "q": "Czy muszę rezerwować z wyprzedzeniem?",
      "a": "Zalecamy rezerwację online przez Booksy lub telefonicznie, aby uniknąć czekania. W miarę wolnych miejsc przyjmujemy też z marszu."
    },
    {
      "q": "Ile trwa wizyta?",
      "a": "Standardowe strzyżenie trwa ok. 45 minut, pełny pakiet Combo (włosy + broda) to ok. 60–75 minut. Zapewniamy pełen komfort i zero pośpiechu."
    },
    {
      "q": "Czym mogę zapłacić?",
      "a": "Przyjmujemy płatność kartą, BLIK-iem oraz gotówką. Paragon lub fakturę otrzymasz na miejscu."
    },
    {
      "q": "Czy mogę odwołać wizytę?",
      "a": "Tak, bezpłatnie do 3 godzin przed planowanym terminem bezpośrednio w aplikacji Booksy lub dzwoniąc do nas."
    },
    {
      "q": "Jak dojechać i gdzie zaparkować?",
      "a": "Przy salonie dostępny jest wygodny parking dla klientów oraz dogodny dojazd komunikacją miejską."
    }
  ],
